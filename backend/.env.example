# ==========================================
# RAGify — Intelligent Document RAG Chatbot
# Environment Configuration
# ==========================================

# Application Settings
APP_NAME=RAGify
APP_ENV=development
DEBUG=True
PORT=8000
HOST=0.0.0.0

# CORS Allowed Origins (comma separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Directory Paths
DATA_DIR=backend/data
UPLOAD_DIR=backend/data/uploads
VECTOR_STORE_DIR=backend/data/vectorstore
EVALUATION_DIR=backend/data/evaluation
DATABASE_URL=sqlite:///backend/data/ragify.db

# LLM Provider Configuration
# Supported providers: "openai", "groq", "gemini", "mock" (offline fallback)
LLM_PROVIDER=mock
LLM_MODEL=llama-3.3-70b-versatile
LLM_API_KEY=
LLM_API_BASE=
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024

# Embedding Model
# Fast, high-quality, 384-dimensional dense vectors
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu

# Chunking Strategy
CHUNK_SIZE=800
CHUNK_OVERLAP=150

# Retrieval & Search Hyperparameters
TOP_K_CANDIDATES=15
TOP_K=5
SEMANTIC_WEIGHT=0.7
BM25_WEIGHT=0.3
CONFIDENCE_THRESHOLD=0.35

# Reranking Configuration
RERANKING_ENABLED=True
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Maximum Document Size in Bytes (default: 20MB)
MAX_FILE_SIZE_BYTES=20971520
